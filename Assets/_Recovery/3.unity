  m_Script: {fileID: 11500000, guid: 21bf79e1961b52e4397e9b001eb17dca, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteractable
  npcName: Dosen Kelas
  dialogue:
    dialogueID: DosenKelas
    lines:
    - characterName: Pak Hadi
      portraitTag: Normal
      characterPortrait: {fileID: 21300000, guid: d3078582164c0a84caacfb3feccad382, type: 3}
      dialogue: Ada apa? tolong dipercepat ya, saya sedang mengajar
      isPlayer: 0
      voiceClip: {fileID: 0}
      hasChoices: 0
      choices: []
    - characterName: You
      portraitTag: Normal
      characterPortrait: {fileID: 21300000, guid: 9a5e81f22bc5fb341b2646876d4c2bf1, type: 3}
      dialogue: ...
      isPlayer: 1
      voiceClip: {fileID: 0}
      hasChoices: 1
      choices:
      - choiceText: Tidak Paham Materi
        branch:
          lines:
          - characterName: You
            portraitTag: Normal
            characterPortrait: {fileID: 21300000, guid: 9a5e81f22bc5fb341b2646876d4c2bf1, type: 3}
            dialogue: Saya Tidak Paham Materi nya pak
            isPlayer: 1
            voiceClip: {fileID: 0}
            hasChoices: 0
            choices: []
          - characterName: Pak Hadi
            portraitTag: Normal
            characterPortrait: {fileID: 21300000, guid: d3078582164c0a84caacfb3feccad382, type: 3}
            dialogue: Kok bisa itu loh? kalo gak paham nanti pelajari sendiri saja
              di modul
            isPlayer: 0
            voiceClip: {fileID: 0}
            hasChoices: 0
            choices: []
          - characterName: You
            portraitTag: Normal
            characterPortrait: {fileID: 21300000, guid: 9a5e81f22bc5fb341b2646876d4c2bf1, type: 3}
            dialogue: Baik Pak
            isPlayer: 1
            voiceClip: {fileID: 0}
            hasChoices: 0
            choices: []
      - choiceText: Gak jadi deh
        branch:
          lines:
          - characterName: You
            portraitTag: Normal
            characterPortrait: {fileID: 21300000, guid: 9a5e81f22bc5fb341b2646876d4c2bf1, type: 3}
            dialogue: Gak jadi pak, saya lupa mau ngomong apa
            isPlayer: 1
            voiceClip: {fileID: 0}
            hasChoices: 0
            choices: []
          - characterName: Pak Hadi
            portraitTag: Normal
            characterPortrait: {fileID: 21300000, guid: d3078582164c0a84caacfb3feccad382, type: 3}
            dialogue: Yaudah, tolong jangan ganggu materi saya
            isPlayer: 0
            voiceClip: {fileID: 0}
            hasChoices: 0
            choices: []
          - characterName: You
            portraitTag: Normal
            characterPortrait: {fileID: 21300000, guid: 9a5e81f22bc5fb341b2646876d4c2bf1, type: 3}
            dialogue: Baik Pak
            isPlayer: 1
            voiceClip: {fileID: 0}
            hasChoices: 0
            choices: []
